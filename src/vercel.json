{
    "rewrites": [
        { 
			"source": "/chatgpt/", 
			"destination": "https://chat.openai.com" 
		},
        {
            "source": "/chatgpt/:match*",
            "destination": "https://chat.openai.com/:match*"
        },
		{ 
			"source": "/okx/", 
			"destination": "https://www.okx.com" 
		},
		{ 
			"source": "/okx/:match*", 
			"destination": "https://www.okx.com/:match*" 
		},
		{ 
			"source": "/okx-ws/", 
			"destination": "wss://ws.okx.com:8443" 
		},
		{ 
			"source": "/okx-ws/:match*", 
			"destination": ""wss://ws.okx.com:8443/:match*" 
		}
    ],
    "github": {
        "silent": true
    }
}
